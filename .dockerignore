# Only the three source trees below are required by Dockerfile. Keeping the
# context explicit prevents local data, credentials, tooling, and build output
# from being sent to the builder.
*
!client/
!client/**
!root/
!root/**
!server/
!server/**

client/.angular/
client/coverage/
client/dist/
client/node_modules/
client/out-tsc/
server/**/bin/
server/**/obj/
server/AdbClient.Web/wwwroot/
