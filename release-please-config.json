{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-header": "This pull request prepares the next version from changes merged since the last release.",
  "pull-request-footer": "Merge this pull request to create the version tag and GitHub release.",
  "packages": {
    ".": {
      "package-name": "alldebrid-client",
      "extra-files": [
        {
          "type": "generic",
          "path": "server/AdbClient.Web/AdbClient.Web.csproj"
        },
        {
          "type": "json",
          "path": "client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "client/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "client/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "generic",
          "path": "Dockerfile"
        }
      ]
    }
  }
}
